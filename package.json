{
    "name": "algorithm-visualizing",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "build-only": "vite build",
        "docs:gen": "bun scripts/generate-docs.ts",
        "docs:dev": "bun scripts/generate-docs.ts && vitepress dev docs",
        "docs:build": "bun scripts/generate-docs.ts && vitepress build docs && node scripts/copy-docs.mjs",
        "build:all": "bun run build && bun run docs:build",
        "type-check": "vue-tsc --build",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "test": "vitest run"
    },
    "dependencies": {
        "pinia": "^4.1.0",
        "vue": "^3.5.45"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.6",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/tsconfig": "^0.9.1",
        "npm-run-all2": "^9.0.4",
        "oxfmt": "^0.79.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.8",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitepress": "^1.6.4",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.14"
    },
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    }
}
