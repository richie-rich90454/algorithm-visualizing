  "sources": {
    "sorting": "Knuth, The Art of Computer Programming Vol. 3; Wikipedia 'Sorting algorithm' and Category:Sorting algorithms; sortingalgos.miraheze.org catalog; Munro-Simon 'Powersort' and pdqsort (Peters) papers.",
    "searching": "Knuth, TAOCP Vol. 3; CLRS Ch. 11-12; NIST Dictionary of Algorithms and Data Structures; Apostolico-Giancarlo and Zhu-Takaoka string-matching papers; Mo's algorithm (informal proceedings).",
    "graph": "CLRS Ch. 22-23; Wikipedia Category:Graph algorithms; NetworkX documentation; Newman 'Networks' for centrality and assortativity; Adamic-Adar (2003) and Newman-Girvan community detection.",
    "shortest-path": "CLRS Ch. 24-25; Wikipedia 'List of pathfinding algorithms'; Pape (1974), Pallottino (1984), Goldberg-Radzik (1998); route-planning literature on highway labeling and alternative routes.",
    "mst": "CLRS Ch. 23; Boruvka/Kruskal/Prim literature; de Berg et al. for geometric MST; dynamic MST surveys (Frederickson).",
    "flow": "CLRS Ch. 26; Ahuja, Magnanti & Orlin, Network Flows; even-shiloach trees (1981); replace-by (Ford-Fulkerson).",
    "tree": "CLRS Ch. 12-14; Sleator-Tarjan link-cut and top trees; Okasaki, Purely Functional Data Structures for persistence; Tarjan's tree-contraction methods.",
    "string": "Gusfield, Algorithms on Strings, Trees, and Sequences; Salomon, Data Compression; universal codes (Elias, Golomb, Rice); Smith-Waterman (1981) and Gotoh (1982).",
    "math": "Knuth, TAOCP Vol. 2; Crandall & Pomerance, Prime Numbers; Cohen, A Course in Computational Algebraic Number Theory; Coppersmith (1996) and lattice-attack literature.",
    "dynamic-programming": "Bellman, Dynamic Programming; CLRS Ch. 15; Knuth optimization and slope-trick (Dragomir-Ionescu) references; standard DP problem literature.",
    "game": "Berlekamp, Conway & Guy, Winning Ways; Coulom 'Monte-Carlo Tree Search' (2006); Browne et al. survey (2012); Zermelo, Lemke-Howson (1964).",
    "geometry": "de Berg et al., Computational Geometry; CGAL documentation; GJK (Gilbert-Johnson-Keerthi), EPA, and Marching Cubes (Lorensen-Cline).",
    "data-structures": "CLRS; Okasaki, Purely Functional Data Structures; Wikipedia 'List of data structures'; Bloom-filter variant literature and perfect-hashing (Fredman-Komlós-Szemerédi).",
    "ml-ai": "NeurIPS/ICML/ICLR/ACL and arXiv papers through 2026 (S4/S5, Mamba lineage, sparse attention, mixture-of-experts, flow matching, diffusion solvers, PEFT methods) and canonical deep-learning texts.",
    "cryptography-security": "NIST FIPS 180-4/202/203/204/205, NIST IR 8545, IACR ePrint, and applied cryptography references; classical cipher references (Kahn, The Codebreakers).",
    "parallel-distributed": "Peer-reviewed consensus and distributed-systems papers (Byzantine Paxos, Jolteon, Honey Badger BFT, CRDTs), Chandy & Lamport (1985), and collective-communication literature (ring/tree all-reduce).",
    "numerical-optimization": "Numerical Recipes; SciPy documentation; Nocedal & Wright, Numerical Optimization; Hairer & Wanner ODE solver tables; Dormand-Prince (1980) and Karmarkar (1984).",
    "quantum": "Nielsen & Chuang; Quantum Algorithm Zoo (Jordan); arXiv quantum algorithm taxonomy; Hallgren (Pell/unit/class group), Kuperberg sieve (2003), Ambainis element distinctness (2005).",
